#!/usr/bin/env python3
"""Run Kalmux straight from a git clone, with no install step.

`kalmux setup` points ~/.local/bin/kalmux at this file. Installing the package instead (uv, pipx,
Homebrew) gives you the same command without it.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from kalmux._entry import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
